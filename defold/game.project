[project]
title = Bunker — Последний шлюз (Defold)
version = 0.51.2
write_log = 0

[bootstrap]
main_collection = /main/main.collectionc
render = /builtins/render/default.renderc

[display]
width = 1280
height = 720
high_dpi = 0
update_frequency = 60

[graphics]
default_texture_min_filter = linear
default_texture_mag_filter = linear

[input]
game_binding = /input/game.input_bindingc
use_accelerometer = 0

[android]
package = org.bunker.defold
version_code = 2
minimum_sdk_version = 21
target_sdk_version = 34

[physics]
type = 2D
